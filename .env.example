# Standalone Java and example application only. Copy to .env and load into your shell.
# Do not commit your .env or point automated tests at application/production databases.
RESEARCH_LOCAL_PASSWORD=replace-with-a-local-password
RESEARCH_JDBC_URL=jdbc:postgresql://localhost:55432/research
RESEARCH_DB_USER=research
RESEARCH_DB_PASSWORD=replace-with-the-same-local-password
RESEARCH_SCHEMA=document_research
RESEARCH_EMBEDDING_DIMENSIONS=768
RESEARCH_DOCLING_URL=http://localhost:55001
RESEARCH_DOCLING_VERSION=docling-serve-v1.30.0
OLLAMA_URL=http://localhost:11434
CHAT_MODEL=qwen2.5:14b
EMBEDDING_MODEL=embeddinggemma
DEMO_PASSWORD=replace-with-a-local-login-password
